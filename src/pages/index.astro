---
import Base from '../layouts/Base.astro';
import { marca, productos, url, precio, enlaceWhatsApp } from '../lib/datos';

const { portada, nosotros, contacto } = marca;
const whatsappGeneral = enlaceWhatsApp(contacto.whatsapp, contacto.mensaje);
---
<Base titulo={`${marca.nombre} | ${marca.eslogan}`} descripcion={portada.subtitulo} pagina="inicio">
  <main>
    <section class="portada" id="inicio">
      <div class="contenedor">
        <div class="portada-texto">
          <h1>{portada.titulo}</h1>
          <p>{portada.subtitulo}</p>
          <a class="boton" href="#productos">{portada.textoBoton}</a>
        </div>
        <div class="portada-imagen">
          <img src={url(portada.imagen)} alt={`Productos de ${marca.nombre}`} width="800" height="600" />
        </div>
      </div>
    </section>

    <section class="seccion" id="productos">
      <div class="contenedor">
        <h2>Nuestros productos</h2>
        <ul class="rejilla">
          {productos.map((p) => (
            <li class="producto">
              <div class="producto-foto">
                <img src={url(p.imagen)} alt={p.nombre} width="800" height="600" loading="lazy" />
                {p.etiqueta && <span class="etiqueta">{p.etiqueta}</span>}
              </div>
              <div class="producto-cabecera">
                <h3>{p.nombre}</h3>
                <span class="precio">{precio(p.precio)}</span>
              </div>
              <p>{p.descripcion}</p>
              <button type="button" class="boton" data-agregar={p.id} data-nombre={p.nombre}>
                Añadir al carrito
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="seccion nosotros" id="nosotros">
      <div class="contenedor">
        <h2>{nosotros.titulo}</h2>
        <div>
          <p>{nosotros.texto}</p>
          {nosotros.puntos.length > 0 && (
            <ul class="puntos">
              {nosotros.puntos.map((punto) => <li>{punto}</li>)}
            </ul>
          )}
        </div>
      </div>
    </section>

    <section class="contacto" id="contacto">
      <div class="contenedor">
        <h2>¿Tienes una consulta antes de comprar?</h2>
        <p>{contacto.horario}</p>
        <a class="boton boton-claro" href={whatsappGeneral} target="_blank" rel="noopener">
          Escríbenos por WhatsApp
        </a>
        {(contacto.instagram || contacto.facebook) && (
          <p class="redes">
            {contacto.instagram && <a href={contacto.instagram} target="_blank" rel="noopener">Instagram</a>}
            {contacto.facebook && <a href={contacto.facebook} target="_blank" rel="noopener">Facebook</a>}
          </p>
        )}
      </div>
    </section>
  </main>
</Base>
